
package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.Disabled;
import org.firstinspires.ftc.robotcore.external.navigation.Orientation;
import org.firstinspires.ftc.robotcore.external.navigation.AxesReference;
import org.firstinspires.ftc.robotcore.external.navigation.AxesOrder;
import org.firstinspires.ftc.robotcore.external.navigation.YawPitchRollAngles;
import org.firstinspires.ftc.robotcore.external.navigation.AngleUnit;
import com.qualcomm.hardware.rev.RevHubOrientationOnRobot;
import com.qualcomm.robotcore.hardware.IMU;
import com.qualcomm.robotcore.hardware.TouchSensor;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.util.ElapsedTime;

import java.text.SimpleDateFormat;
import java.util.Date;



@TeleOp

public class BabysFirstStep extends OpMode {

    //Declare class
    private class Point{
        private double x, y;
        public Point(double x, double y){
            this.x = x;
            this.y = y;
        }
    }
    private class Base{
        private DcMotor motor_lb;
        private DcMotor motor_lf;
        private DcMotor motor_rb;
        private DcMotor motor_rf;
    }
    private class Elevator{
        private DcMotor motor_l;
        private DcMotor motor_r;
    }
    private class Grabber{
        private DcMotor motor_l;
        private DcMotor motor_r;
        //private servo sv_roller;
    }
    Base base = new Base();
    Elevator elevator = new Elevator();
    Grabber grabber = new Grabber();

    /* Declare OpMode members. */

    private double teta = Math.toRadians(45);
    double epsilon = 0.00001;
    double factor = 1/Math.abs(Math.sin(teta));

    private IMU imu;
    private NavxMicroNavigationSensor navx;
    boolean isPOV = false;

    @Override
    public void init() {
        telemetry.addData("Status", "Initialized");

navx = robotGlobal.hardwareMap.get(NavxMicroNavigationSensor.class, "navx");
        imu = hardwareMap.get(IMU.class, "imu");
        imu.initialize(
     new IMU.Parameters(
          new RevHubOrientationOnRobot(
               RevHubOrientationOnRobot.LogoFacingDirection.UP,
               RevHubOrientationOnRobot.UsbFacingDirection.LEFT
          )
     )
);
        imu.resetYaw();

        base.motor_lb = hardwareMap.get(DcMotor.class, "leftRearBase");
        base.motor_lf = hardwareMap.get(DcMotor.class, "leftFrontBase");
        base.motor_rb = hardwareMap.get(DcMotor.class, "rightRearBase");
        base.motor_rf = hardwareMap.get(DcMotor.class, "rightFrontBase");

        elevator.motor_l = hardwareMap.get(DcMotor.class, "leftElevator");
        elevator.motor_r = hardwareMap.get(DcMotor.class, "rightElevator");

        grabber.motor_l = hardwareMap.get(DcMotor.class, "leftGrabber");
        grabber.motor_r = hardwareMap.get(DcMotor.class, "rightGrabber");

        base.motor_lb.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        base.motor_lf.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        base.motor_rb.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        base.motor_rf.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);

        elevator.motor_l.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        elevator.motor_r.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);

        grabber.motor_l.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        grabber.motor_r.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);

        base.motor_lb.setDirection(DcMotor.Direction.FORWARD);
        base.motor_lf.setDirection(DcMotor.Direction.FORWARD);
        base.motor_rb.setDirection(DcMotor.Direction.FORWARD);
        base.motor_rf.setDirection(DcMotor.Direction.FORWARD);

        elevator.motor_l.setDirection(DcMotor.Direction.REVERSE);
        elevator.motor_r.setDirection(DcMotor.Direction.FORWARD);

        grabber.motor_l.setDirection(DcMotor.Direction.REVERSE);
        grabber.motor_r.setDirection(DcMotor.Direction.FORWARD);


        base.motor_lb.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        base.motor_lf.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        base.motor_rb.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        base.motor_rf.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        elevator.motor_l.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        elevator.motor_r.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        grabber.motor_l.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        grabber.motor_r.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

    }

    /*
     * Code to run REPEATEDLY after the driver hits INIT, but before they hit PLAY
     */
    @Override
    public void init_loop() {
    }

    /*
     * Code to run ONCE when the driver hits PLAY
     */
    @Override
    public void start() {

    }

    /*
     * Code to run REPEATEDLY after the driver hits PLAY but before they hit STOP
     */
    @Override
    public void loop() {
        double turn = -gamepad1.right_stick_x;
        Point dir_vector = new Point(gamepad1.left_stick_x, -gamepad1.left_stick_y);
        boolean elevator_control_up = gamepad1.dpad_up;
        boolean elevator_control_down = gamepad1.dpad_down;
        boolean grabber_control_outward = gamepad1.dpad_right;
        boolean grabber_control_inward = gamepad1.dpad_left;

        // Get Robot Orientation
        Orientation myRobotOrientation = imu.getRobotOrientation(
             AxesReference.INTRINSIC,
             AxesOrder.XYZ,
             AngleUnit.DEGREES
        );

        // Then read or display the desired values (Java type float):
        double pov_angle = myRobotOrientation.thirdAngle;

        if(pov_angle < 0){
            pov_angle = 360-Math.abs(pov_angle);
        }
        double a = 45;
        if(pov_angle >= a && pov_angle <= 180-a){
            pov_angle += 180;
        } else if(pov_angle >= 270-a && pov_angle <= 270+a){
            pov_angle -= 180;
        }
        pov_angle = Math.toRadians(pov_angle);
        dir_vector = changementDeBase(dir_vector, pov_angle);

        boolean f = false;

        if(Math.abs(turn) >= epsilon){
            base.motor_lb.setPower(turn);
            base.motor_rf.setPower(turn);
            base.motor_rb.setPower(turn);
            base.motor_lf.setPower(turn);
        } else{
            if(Math.abs(dir_vector.x+dir_vector.y) <= epsilon){
                dir_vector.x = dir_vector.x*factor;
                dir_vector.y = dir_vector.y*factor;
                f = true;
            }
            base.motor_lb.setPower(-dir_vector.y);
            base.motor_rf.setPower(dir_vector.y);
            base.motor_rb.setPower(dir_vector.x);
            base.motor_lf.setPower(-dir_vector.x);
        }

        double elevator_power = 0;
        if(elevator_control_up){
            elevator_power = 1;
        } else if(elevator_control_down){
            elevator_power = -1;
        }
        elevator.motor_l.setPower(elevator_power);
        elevator.motor_r.setPower(elevator_power);

        double grabber_power = 0;
        if(grabber_control_outward){
            grabber_power = 1;
        } else if(grabber_control_inward){
            grabber_power = -1;
        }
        grabber.motor_l.setPower(grabber_power);
        grabber.motor_r.setPower(grabber_power);

        // Put loop blocks here.
        telemetry.addData("Joystick", "((%.2f), (%.2f))", gamepad1.left_stick_x, -gamepad1.left_stick_y);
        telemetry.addData("Movement", "((%.2f), (%.2f))", dir_vector.x, -dir_vector.y);
        telemetry.addData("Elevator", "(%.2f)", elevator_power);
        telemetry.addData("Factor", Math.abs(dir_vector.x-dir_vector.y));
        telemetry.addData("Grabber", "(%.2f)", grabber_power);
        telemetry.addData("Orientation", pov_angle);
        telemetry.update();

    }

    /*
     * Code to run ONCE after the driver hits STOP
     */
    @Override
    public void stop() {

    }

    public Point changementDeBase(Point p, double teta2){
        double temp_a = 0;
        if(isPOV){
            temp_a = teta-teta2;
        } else{
            temp_a = teta;
        }

        double x_prime = p.x*Math.cos(temp_a) + p.y*Math.sin(temp_a);
        double y_prime = -p.x*Math.sin(temp_a) + p.y*Math.cos(temp_a);
        return new Point(x_prime, y_prime);
    }
}